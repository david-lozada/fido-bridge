# Allow the logged-in user to open /dev/uhid for the bridge daemon.
KERNEL=="uhid", GROUP="fidobridge", MODE="0660", TAG+="uaccess"

# Virtual FIDO Bridge HID device (VID 0x1209 / PID 0xF1D0) — browser access via uaccess.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1209", ATTRS{idProduct}=="f1d0", TAG+="uaccess", MODE="0660"
SUBSYSTEM=="usb", ATTRS{idVendor}=="1209", ATTRS{idProduct}=="f1d0", TAG+="uaccess"
