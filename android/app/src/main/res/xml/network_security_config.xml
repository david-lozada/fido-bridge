<?xml version="1.0" encoding="utf-8"?>
<!-- Pairing uses self-signed daemon certs pinned by fingerprint in app code. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
